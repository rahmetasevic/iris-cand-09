# Developer workstation: DE / NW with the bundled mock HTTP source.
#   cp deploy/dev.env.example .env
# Contains no secrets: the database password lives in the file named by
# IRIS_DB_SECRET_FILE (generated by scripts/smoke.* when missing).

# --- compose project -------------------------------------------------------
COMPOSE_PROJECT_NAME=iris-dev
# "mock-source" starts the local HTTP stand-in for the source endpoint.
COMPOSE_PROFILES=mock-source

# --- scope -----------------------------------------------------------------
IRIS_COUNTRY_CODE=DE
IRIS_REGION_CODE=NW

# --- source ----------------------------------------------------------------
# {country_code} and {region_code} are expanded by the worker.
IRIS_SOURCE_ENDPOINT=http://source:8080/{country_code}-{region_code}/sites.geojson
IRIS_SOURCE_TIMEOUT_S=30

# --- database --------------------------------------------------------------
IRIS_DB_NAME=iris
IRIS_DB_USER=iris
IRIS_DB_SECRET_FILE=./secrets/db_password
IRIS_POSTGIS_IMAGE=postgis/postgis:16-3.4

# --- output ----------------------------------------------------------------
# Path inside the container, and what is mounted there: a named volume
# ("output") or an absolute/relative host directory.
IRIS_OUTPUT_DIR=/data/output
IRIS_OUTPUT_MOUNT=output

# --- screening assumptions -------------------------------------------------
IRIS_ECO_POINTS_PER_M2=8
IRIS_MAX_REJECT_RATIO=0.5

# --- process ---------------------------------------------------------------
IRIS_LOG_LEVEL=INFO
IRIS_STARTUP_TIMEOUT_S=60
# 0 = run once and exit; >0 = keep running and re-ingest every N seconds.
IRIS_RUN_INTERVAL_S=0
