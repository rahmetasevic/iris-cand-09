# Second host: a different country/region, a file-based source mounted from
# the host, a separate compose project and database, and a long-running
# worker. Same image, same code; only this file differs.
#   cp deploy/second-host.env.example deploy/second-host.env   # then adjust paths
#   scripts/smoke.sh deploy/second-host.env

# --- compose project -------------------------------------------------------
# A distinct project name keeps containers, volumes and networks separate,
# so this stack can even share a Docker host with the dev stack.
COMPOSE_PROJECT_NAME=iris-at9
# No mock HTTP source; the feed is read from a mounted directory.
COMPOSE_PROFILES=

# --- scope -----------------------------------------------------------------
IRIS_COUNTRY_CODE=AT
IRIS_REGION_CODE=9

# --- source ----------------------------------------------------------------
# IRIS_SOURCE_MOUNT is the host directory mounted read-only at /data/source.
# The committed fixtures are used here so the file works out of the box;
# point it at the real drop directory on the target host.
IRIS_SOURCE_MOUNT=./fixtures
IRIS_SOURCE_ENDPOINT=file:///data/source/{country_code}-{region_code}/sites.geojson

# --- database --------------------------------------------------------------
IRIS_DB_NAME=iris_at
IRIS_DB_USER=iris_at
# Keep secrets outside the checkout on shared hosts, e.g. /etc/iris/db_password
IRIS_DB_SECRET_FILE=./secrets/at9_db_password
IRIS_POSTGIS_IMAGE=postgis/postgis:16-3.4

# --- output ----------------------------------------------------------------
IRIS_OUTPUT_DIR=/data/output
# Named volume by default. For a host directory use an absolute path and set
# IRIS_UID/IRIS_GID to the owner of that directory, e.g.
#   IRIS_OUTPUT_MOUNT=/srv/iris/output
#   IRIS_UID=1000
#   IRIS_GID=1000
IRIS_OUTPUT_MOUNT=output

# --- screening assumptions -------------------------------------------------
IRIS_ECO_POINTS_PER_M2=8
IRIS_MAX_REJECT_RATIO=0.45

# --- process ---------------------------------------------------------------
IRIS_LOG_LEVEL=INFO
IRIS_STARTUP_TIMEOUT_S=120
# Re-ingest every 6 hours and restart after crashes or host reboots.
IRIS_RUN_INTERVAL_S=21600
IRIS_WORKER_RESTART=unless-stopped
